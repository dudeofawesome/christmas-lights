{
  "name": "christmas-lights",
  "version": "0.0.1",
  "description": "My Christmas Lights",
  "main": "out/index.js",
  "type": "module",
  "engines": {
    "node": "26"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env .",
    "dev": "tsx --env-file=.env --inspect src/index.ts",
    "debug": "tsx --env-file=.env --inspect --inspect-brk src/index.ts",
    "watch": "nodemon --watch src/ --watch *.env* --exec 'npm run dev'",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run .test.ts --no-file-parallelism",
    "test:unit:debug": "vitest .test.ts --inspect-brk --no-file-parallelism --coverage=false --testTimeout=600000 --watch",
    "test:integration": "vitest run .spec.ts --no-file-parallelism",
    "test:integration:debug": "vitest .spec.ts --inspect-brk --no-file-parallelism --coverage=false --testTimeout=600000 --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/dudeofawesome/christmas-lights.git"
  },
  "author": "Louis Orleans <louis@orleans.io>",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/dudeofawesome/christmas-lights/issues"
  },
  "homepage": "https://github.com/dudeofawesome/christmas-lights#readme",
  "dependencies": {
    "chalk": "^5.1.2",
    "color-convert": "^2.0.1",
    "dotenv": "^16.0.3",
    "serialport": "^13.0.0",
    "source-map-support": "^0.5.21",
    "sunrise-sunset-js": "^2.2.1"
  },
  "devDependencies": {
    "@iunu-inc/code-style": "^0.0.10",
    "@types/color-convert": "^2.0.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^5.30.6",
    "@typescript-eslint/parser": "^5.30.6",
    "nodemon": "^2.0.20",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "@serialport/bindings-cpp@13.0.0": true,
    "core-js-pure@3.26.1": true,
    "fsevents@2.3.2": true
  }
}
